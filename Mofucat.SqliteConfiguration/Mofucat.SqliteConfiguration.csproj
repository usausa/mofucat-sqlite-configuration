<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mofucat.SqliteConfiguration</PackageId>
    <Title>Mofucat.SqliteConfiguration</Title>
    <Description>.NET Configuration Extensions for SQLite.</Description>
    <PackageTags>configuration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
  </ItemGroup>

</Project>
